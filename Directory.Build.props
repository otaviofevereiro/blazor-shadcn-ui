<Project>
  <PropertyGroup>
    <!-- Package Metadata - Common to all BlazorUI packages -->
    <Authors>Otavio Fevereiro</Authors>
    <Company>Otsail</Company>
    <Copyright>Copyright (c) 2025-present Otavio Fevereiro</Copyright>

    <!-- License and Repository -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/otaviofevereiro/blazor-shadcn-ui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/otaviofevereiro/blazor-shadcn-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
